# Prevent data re-initialization on reset.
@set 1A4234 60000000

# Widescreen support.
# These are the C2 codes that Nintendont can't write on its own.
# They are disabled by default.
@file 2FCFC4 asm/widescreen/adjust_nametag_background_x_scale.asm
# The CObj code conflicts with Nintendon'ts widescreen patch.
#@file 36A4A8 asm/widescreen/overwrite_cobj_values.asm

# ========================
# General 6 player support.
# ========================

# 24MB ARAM, regardless of what ARGetSize reports.
@set 015684 3C000180
@set 01568C 60000000

# AllA heap size 0x96C800 -> 0xD6C800 for six character animations.
@set 3BA3BC 00D6C800

@file 028494 asm/sfx_bank_six_players.asm

# ===============
# Rumble support.
# ===============

@asm 3780B0 lis r4, rumble_data@ha # HSD_PadRumbleOn
@asm 3780B4 addi r0, r4, rumble_data@l
@asm 3780FC lis r4, rumble_data@ha # HSD_PadRumbleOffN
@asm 378100 addi r0, r4, rumble_data@l
@asm 378184 lis r3, rumble_data@ha # HSD_PadRumbleRemove
@asm 37818C addi r0, r3, rumble_data@l
@asm 37820C lis r3, rumble_data@ha # HSD_PadRumbleRemoveAll
@asm 37821C addi r31, r3, rumble_data@l
@asm 378264 cmpwi r27, 6
@asm 378298 lis r3, rumble_data@ha # HSD_PadRumbleRemoveId
@asm 37829C addi r0, r3, rumble_data@l
@asm 378334 lis r3, rumble_data@ha # HSD_PadRumblePauseAll
@asm 37834C addi r30, r3, rumble_data@l
@asm 37838C cmpwi r29, 6
@asm 3783B4 lis r3, rumble_data@ha # HSD_PadRumbleUnpauseAll
@asm 3783CC addi r30, r3, rumble_data@l
@asm 37840C cmpwi r29, 6
@asm 37844C lis r3, rumble_data@ha # HSD_PadRumbleAdd
@asm 378454 addi r0, r3, rumble_data@l
@asm 3786FC lis r3, rumble_data@ha # HSD_PadRumbleInterpret
@asm 378708 addi r0, r3, rumble_data@l
@asm 378808 cmpwi r27, 6
@asm 378848 lis r8, rumble_data@ha # HSD_PadRumbleInit
@asm 378854 addi r3, r8, rumble_data@l
@file 378A24 asm/rumble_data_init.asm
@asm 01461C cmpwi r31, 6 # lb_800145F4
@asm 16F0B0 cmpwi r30, 6 # gm_LoadRumbleEnabled

@buffer rumble_56_enabled 2 # Byte per port for P5/P6.
